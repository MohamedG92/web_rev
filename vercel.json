{
  "version": 2,
  "builds": [
    { "src": "back/index.js", "use": "@vercel/node" },
    { "src": "front/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(api/.*|login|sign-up)", "dest": "back/index.js" },
    { "src": "/", "dest": "front/index.html" },
    { "src": "/(.*)", "dest": "front/$1" }
  ]
}
